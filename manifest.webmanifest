{
  "name": "AlpaGo — city day routes",
  "short_name": "AlpaGo",
  "description": "Builds an optimised day route through any city from real OpenStreetMap places.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
